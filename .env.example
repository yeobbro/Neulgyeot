# Copy to .env.local. Never commit real values.
# Optional local LLM drafts (OpenAI-compatible: Ollama, vLLM, LM Studio …) — see docs/LOCAL_LLM.md.
# Leave LOCAL_LLM_MODEL empty to use rule-based drafts only.
LOCAL_LLM_MODEL=
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# Only if the inference server requires a bearer key.
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=120000
LOCAL_LLM_MAX_TOKENS=900
