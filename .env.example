# Copy to .env.local. Never commit real values.

# Session signing secret (32+ characters). Required when NODE_ENV=production.
NEULGYEOT_SESSION_SECRET=

# Demo sign-in with synthetic accounts. Defaults to enabled in development,
# disabled in production unless set to "true". Set "false" to turn it off.
NEULGYEOT_DEMO_LOGIN=

# PGlite data directory. Default: .data/pglite (or /tmp/neulgyeot-pglite on Vercel).
# Use "memory://" for a throwaway in-memory database.
NEULGYEOT_DB_DIR=

# Seed demo data automatically on first start (default: true).
NEULGYEOT_AUTO_SEED=

# Optional: Claude API for record interpretation, transcript structuring and report drafts.
# Server-side only; never expose to the browser. Without it, rule-based features still work.
ANTHROPIC_API_KEY=
# Model override (default: claude-opus-5-5).
NEULGYEOT_AI_MODEL=
# Set "false" to disable AI even when a key is present.
NEULGYEOT_AI_ENABLED=
